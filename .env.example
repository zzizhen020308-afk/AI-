# 复制为 .env 后填入；.env 已被 .gitignore 排除，不会提交。
# 不填 NOVEL_API_KEY 时引擎自动进入离线 mock 模式（只验证流程）。

# 任意 OpenAI 兼容服务：
#   DeepSeek   https://api.deepseek.com/v1        deepseek-chat
#   OpenAI     https://api.openai.com/v1          gpt-4o-mini
#   Ollama     http://localhost:11434/v1          qwen2.5:14b
#   OpenRouter https://openrouter.ai/api/v1       <模型名>
NOVEL_API_BASE=https://api.deepseek.com/v1
NOVEL_API_KEY=
NOVEL_MODEL=deepseek-chat
NOVEL_TEMPERATURE=0.8
NOVEL_MAX_TOKENS=4096
